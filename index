    function triggerSweepBar() {
      const bar = document.getElementById("pageSweepBar");
      if (!bar) return;
      bar.classList.remove("sweeping");
      void bar.offsetWidth;
      bar.classList.add("sweeping");
    }

    function initScrollReveals(container = document) {
      const items = container.querySelectorAll(".reveal-item");
      if (!("IntersectionObserver" in window)) {
        items.forEach(el => el.classList.add("revealed"));
        return;
      }
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add("revealed");
            }, i * 65);
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      items.forEach(el => {
        el.classList.remove("revealed");
        observer.observe(el);
      });
    }

    function switchPage(pageId) {
      if (isSwitchingPage || pageId === currentActivePage) {
        window.scrollTo({ top: 0, behavior: "smooth" });
        return;
      }

      const oldPage = document.getElementById("page-" + currentActivePage);
      const nextPage = document.getElementById("page-" + pageId);
      const curtain = document.getElementById("cinemaCurtainOverlay");
      const curtainLabel = document.getElementById("curtainSectionLabel");
      if (!nextPage) return;

      isSwitchingPage = true;
      triggerSweepBar();

      const pageTitles = {
        cinema: "CINEMA DETAILS",
        food: "FOOD & SNACKS",
        reviews: "AUDIENCE REVIEWS"
      };
      if (curtainLabel) curtainLabel.textContent = pageTitles[pageId] || "THEATRON";
      if (curtain) curtain.classList.add("closed");

      document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
      const navBtn = document.getElementById("nav-" + pageId);
      if (navBtn) navBtn.classList.add("active");

      setTimeout(() => {
        if (oldPage) oldPage.classList.remove("active", "leaving");
        nextPage.classList.add("active");
        currentActivePage = pageId;
        window.scrollTo({ top: 0, behavior: "instant" });
        initScrollReveals(nextPage);

        if (curtain) curtain.classList.remove("closed");
        setTimeout(() => {
          isSwitchingPage = false;
        }, 360);
      }, 340);
    }

