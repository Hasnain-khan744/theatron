<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>THEATRON | Cinema Details, Food & Snacks, Reviews</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-obsidian: #0d0406;
      --bg-velvet: #24080d;
      --border-burgundy: rgba(185, 45, 68, 0.32);
      --border-gold: rgba(212, 175, 55, 0.5);
      --gold-primary: #d4af37;
      --gold-light: #f3d98b;
      --crimson-glow: #9e1b32;
      --text-white: #f8f4f0;
      --text-muted: #c2a6a4;
      --font-display: 'Cinzel', serif;
      --font-sans: 'Plus Jakarta Sans', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: radial-gradient(circle at 50% 0%, #320b12 0%, var(--bg-obsidian) 62%);
      color: var(--text-white);
      font-family: var(--font-sans);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Cinematic Page-Switch Sweep Bar */
    .page-sweep-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, #9e1b32, var(--gold-primary), #fff3c4);
      box-shadow: 0 0 14px var(--gold-primary);
      z-index: 999;
      pointer-events: none;
      opacity: 0;
    }

    .page-sweep-bar.sweeping {
      animation: cinemaSweep 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes cinemaSweep {
      0% { width: 0%; opacity: 1; }
      70% { width: 100%; opacity: 1; }
      100% { width: 100%; opacity: 0; }
    }

    /* Full-Screen Cinema Velvet Curtain Transition Overlay */
    .cinema-curtain-overlay {
      position: fixed;
      inset: 0;
      z-index: 950;
      pointer-events: none;
      display: flex;
      overflow: hidden;
    }

    .curtain-panel {
      width: 50%;
      height: 100%;
      background:
        repeating-linear-gradient(
          90deg,
          rgba(0, 0, 0, 0.35) 0px,
          rgba(158, 27, 50, 0.25) 18px,
          rgba(26, 5, 9, 0.65) 36px
        ),
        linear-gradient(180deg, #320912 0%, #140306 55%, #090103 100%);
      transition: transform 0.36s cubic-bezier(0.77, 0, 0.175, 1);
      box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.85);
    }

    .curtain-left {
      transform: translateX(-102%);
      border-right: 2px solid var(--gold-primary);
    }

    .curtain-right {
      transform: translateX(102%);
      border-left: 2px solid var(--gold-primary);
    }

    .cinema-curtain-overlay.closed .curtain-left,
    .cinema-curtain-overlay.closed .curtain-right {
      transform: translateX(0%);
    }

    .curtain-emblem {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.82);
      opacity: 0;
      text-align: center;
      transition: opacity 0.22s ease, transform 0.28s ease;
      z-index: 2;
    }

    .cinema-curtain-overlay.closed .curtain-emblem {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    /* Top Utility Bar */
    .top-utility {
      background: #080203;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      padding: 8px 4%;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .gold-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold-primary);
      display: inline-block;
      margin-right: 6px;
      box-shadow: 0 0 8px var(--gold-primary);
      animation: pulseGoldDot 2.2s infinite ease-in-out;
    }

    @keyframes pulseGoldDot {
      0%, 100% { transform: scale(1); opacity: 0.85; }
      50% { transform: scale(1.45); opacity: 1; }
    }

    /* Main Header Navigation */
    .navbar {
      background: rgba(13, 4, 6, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-burgundy);
      padding: 14px 4%;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.25s ease;
    }

    .brand:hover {
      transform: translateY(-1px);
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(145deg, #330b13, #160407);
      border: 1px solid var(--border-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      color: var(--gold-primary);
      font-size: 19px;
      font-weight: 800;
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.18);
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .brand:hover .brand-icon {
      transform: rotate(-4deg) scale(1.06);
      box-shadow: 0 0 22px rgba(212, 175, 55, 0.42);
    }

    .brand-text h1 {
      font-family: var(--font-display);
      font-size: 18px;
      letter-spacing: 0.18em;
      color: var(--text-white);
      line-height: 1.1;
    }

    .brand-text span {
      font-size: 9px;
      letter-spacing: 0.25em;
      color: var(--text-muted);
      display: block;
      margin-top: 2px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      list-style: none;
    }

    .nav-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      font-size: 13px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 10px;
      cursor: pointer;
      position: relative;
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-btn:hover {
      color: var(--text-white);
      background: rgba(158, 27, 50, 0.18);
      transform: translateY(-1px);
    }

    .nav-btn.active {
      color: var(--gold-light);
      background: rgba(158, 27, 50, 0.34);
      border-color: var(--border-burgundy);
      box-shadow: 0 0 18px rgba(158, 27, 50, 0.38);
    }

    .tray-btn {
      background: linear-gradient(145deg, #25080e, #140407);
      border: 1px solid var(--border-gold);
      color: var(--text-white);
      padding: 9px 15px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tray-btn:hover {
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.34);
      transform: translateY(-2px);
    }

    .badge-count {
      background: var(--gold-primary);
      color: #120406;
      font-weight: 800;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 6px;
      transition: transform 0.25s ease;
    }

    .tray-btn:hover .badge-count {
      transform: scale(1.12);
    }

    /* Page View Switching with Cinematic Motion */
    .page-view {
      display: none;
    }

    .page-view.active {
      display: block;
      animation: cinemaCurtainEnter 0.58s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .page-view.leaving {
      display: block;
      animation: cinemaCurtainExit 0.24s ease-in forwards;
      pointer-events: none;
    }

    @keyframes cinemaCurtainEnter {
      0% {
        opacity: 0;
        transform: translateY(22px) scale(0.985);
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes cinemaCurtainExit {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translateY(-14px) scale(0.99);
      }
    }

    /* In-Page Scroll Reveal & Ambient Float Motions */
    .reveal-item {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal-item.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .float-slow {
      animation: gentleCinemaFloat 5.2s ease-in-out infinite alternate;
    }

    @keyframes gentleCinemaFloat {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-9px); }
    }

    .panel-swap-anim {
      animation: panelFadeSlide 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes panelFadeSlide {
      from { opacity: 0; transform: translateY(12px) scale(0.99); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Shared Hero Typography */
    .hero-section {
      padding: 42px 4% 28px;
      text-align: center;
    }

    .pill-tag {
      display: inline-block;
      padding: 6px 18px;
      border-radius: 999px;
      background: rgba(24, 6, 10, 0.9);
      border: 1px solid var(--border-burgundy);
      color: var(--gold-light);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4.4vw, 3.5rem);
      line-height: 1.12;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .hero-title span {
      display: block;
      color: var(--gold-primary);
      text-shadow: 0 4px 26px rgba(212, 175, 55, 0.3);
    }

    .hero-subtitle {
      max-width: 660px;
      margin: 0 auto 30px;
      color: var(--text-muted);
      font-size: 14.5px;
      line-height: 1.65;
    }

    /* Buttons & Filter Pills */
    .gold-cta-btn {
      padding: 12px 24px;
      border-radius: 10px;
      border: none;
      background: linear-gradient(135deg, var(--gold-primary), #b38b22);
      color: #120406;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, filter 0.25s ease;
    }

    .gold-cta-btn::after {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      transition: left 0.55s ease;
    }

    .gold-cta-btn:hover::after {
      left: 140%;
    }

    .gold-cta-btn:hover {
      filter: brightness(1.08);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(212, 175, 55, 0.38);
    }

    .gold-cta-btn:active {
      transform: translateY(0) scale(0.98);
    }

    .filter-btn {
      background: #160508;
      border: 1px solid var(--border-burgundy);
      color: var(--text-muted);
      padding: 9px 20px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .filter-btn:hover {
      color: var(--text-white);
      border-color: var(--gold-primary);
      transform: translateY(-1px);
    }

    .filter-btn.active {
      background: linear-gradient(135deg, #6e1222, #3b0811);
      border-color: var(--gold-primary);
      color: var(--gold-light);
      box-shadow: 0 4px 18px rgba(158, 27, 50, 0.45);
    }

    .seat-select {
      background: #0e0305;
      border: 1px solid var(--border-burgundy);
      color: var(--text-white);
      padding: 9px 14px;
      border-radius: 10px;
      font-size: 12.5px;
      outline: none;
    }

    /* Interactive Image Zoom & Card Hover Lift */
    .cinema-zoom-img {
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .group-card:hover .cinema-zoom-img,
    .combo-card:hover .cinema-zoom-img,
    .food-card:hover .cinema-zoom-img {
      transform: scale(1.07);
    }

    .group-card {
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.32s ease, box-shadow 0.32s ease;
    }

    .group-card:hover {
      transform: translateY(-5px);
      border-color: var(--border-gold) !important;
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.8), 0 0 22px rgba(212, 175, 55, 0.14);
    }

    /* Food & Snacks Styles */
    .lcd-master-frame {
      max-width: 1040px;
      margin: 0 auto 48px;
      background: #0c0305;
      border: 2px solid #380f17;
      border-radius: 22px;
      padding: 14px 18px 20px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.88), 0 0 60px rgba(158, 27, 50, 0.35);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .lcd-master-frame:hover {
      box-shadow: 0 34px 75px rgba(0, 0, 0, 0.92), 0 0 70px rgba(212, 175, 55, 0.22);
    }

    .combo-marquee {
      background: linear-gradient(155deg, #21070c 0%, #100305 60%, #1c060a 100%);
      border: 1.5px solid var(--border-gold);
      border-radius: 24px;
      padding: 28px;
      position: relative;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85), 0 0 35px rgba(212, 175, 55, 0.14);
    }

    .combo-card {
      background: linear-gradient(180deg, #1d070c 0%, #0f0305 100%);
      border: 1px solid var(--border-burgundy);
      border-radius: 18px;
      overflow: hidden;
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .combo-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-gold);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.82);
    }

    .battle-arena-box {
      background: linear-gradient(160deg, #1b060a 0%, #0e0204 55%, #190509 100%);
      border: 1px solid var(--border-burgundy);
      border-radius: 22px;
      padding: 26px;
    }

    .battle-match-card {
      background: #130407;
      border: 1px solid var(--border-burgundy);
      border-radius: 18px;
      padding: 18px;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .battle-match-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-gold);
    }

    .food-card {
      background: linear-gradient(180deg, #1c070b 0%, #100305 100%);
      border: 1px solid var(--border-burgundy);
      border-radius: 18px;
      overflow: hidden;
      transition: all 0.32s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
    }

    .food-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-gold);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.78);
    }

    /* Reviews Styles */
    .rating-bar-row {
      display: flex;
      align-items: center;
      gap: 12px;
      transition: transform 0.2s ease;
    }

    .rating-bar-row:hover {
      transform: translateX(4px);
    }

    .rating-bar-track {
      flex: 1;
      height: 10px;
      background: #0a0203;
      border-radius: 999px;
      border: 1px solid var(--border-burgundy);
      overflow: hidden;
    }

    .rating-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #9e1b32, var(--gold-primary));
      border-radius: 999px;
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .rotw-spotlight {
      background: linear-gradient(145deg, #24080e 0%, #110306 55%, #1d070c 100%);
      border: 1.5px solid var(--border-gold);
      border-radius: 24px;
      padding: 28px 30px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 26px 60px rgba(0, 0, 0, 0.85), 0 0 40px rgba(212, 175, 55, 0.16);
    }

    .review-card {
      background: linear-gradient(180deg, #1b070b 0%, #100305 100%);
      border: 1px solid var(--border-burgundy);
      border-radius: 18px;
      padding: 22px;
      transition: all 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .review-card:hover {
      border-color: var(--border-gold);
      transform: translateY(-5px);
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.75);
    }

    .movie-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      padding: 4px 11px;
      border-radius: 999px;
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.32);
      color: var(--gold-light);
    }

    /* Slide-Out Tray Drawer */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(4px);
      z-index: 200;
      display: none;
    }

    .drawer-backdrop.open {
      display: block;
    }

    .slide-drawer {
      position: fixed;
      top: 0;
      right: -460px;
      width: 100%;
      max-width: 440px;
      height: 100vh;
      background: #130407;
      border-left: 1px solid var(--border-gold);
      z-index: 201;
      padding: 20px;
      display: flex;
      flex-direction: column;
      transition: right 0.38s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
    }

    .slide-drawer.open {
      right: 0;
    }

    .pay-pill {
      background: #170508;
      border: 1px solid var(--border-burgundy);
      color: var(--text-muted);
      padding: 7px 8px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s ease;
    }

    .pay-pill:hover {
      border-color: var(--gold-primary);
      color: var(--text-white);
    }

    .pay-pill.active {
      border-color: var(--gold-primary);
      color: var(--gold-light);
      background: rgba(212, 175, 55, 0.16);
    }

    .toast-banner {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #1b060a;
      border: 1px solid var(--gold-primary);
      color: var(--gold-light);
      padding: 12px 22px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.85);
      z-index: 250;
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast-banner.show {
      transform: translateX(-50%) translateY(0);
    }
  </style>
</head>
<body>

  <!-- Top Golden Page-Transition Sweep Indicator -->
  <div class="page-sweep-bar" id="pageSweepBar"></div>

  <!-- Theatrical Velvet Curtain Overlay for Page Changes -->
  <div class="cinema-curtain-overlay" id="cinemaCurtainOverlay" aria-hidden="true">
    <div class="curtain-panel curtain-left"></div>
    <div class="curtain-panel curtain-right"></div>
    <div class="curtain-emblem">
      <div style="width: 54px; height: 54px; margin: 0 auto 8px; border-radius: 14px; background: linear-gradient(145deg, #330b13, #160407); border: 1.5px solid var(--gold-primary); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); color: var(--gold-primary); font-size: 26px; font-weight: 800; box-shadow: 0 0 30px rgba(212,175,55,0.45);">T</div>
      <span id="curtainSectionLabel" style="font-family: var(--font-display); font-size: 13px; letter-spacing: 0.26em; color: var(--gold-light); text-transform: uppercase;">THEATRON</span>
    </div>
  </div>

  <!-- Top Utility Strip -->
  <div class="top-utility">
    <div>
      <span>PRIVATE SCREENING & LUXURY CINEMA</span>
      <span class="mx-2">|</span>
      <span><i class="gold-dot"></i>MEMBER 5 • CINEMA DETAILS, FOOD & REVIEWS</span>
    </div>
    <div>
      <span>ISLAMABAD FLAGSHIP</span>
      <span class="mx-2">|</span>
      <span>Alexander</span>
    </div>
  </div>

  <!-- Main Header Navigation -->
  <nav class="navbar">
    <a class="brand" onclick="switchPage('cinema')">
      <div class="brand-icon">T</div>
      <div class="brand-text">
        <h1>THEATRON</h1>
        <span>CINEMA LOUNGES</span>
      </div>
    </a>

    <ul class="nav-links">
      <li><button class="nav-btn active" id="nav-cinema" onclick="switchPage('cinema')">Cinema Details</button></li>
      <li><button class="nav-btn" id="nav-food" onclick="switchPage('food')">Food & Snacks</button></li>
      <li><button class="nav-btn" id="nav-reviews" onclick="switchPage('reviews')">Reviews</button></li>
    </ul>

    <div>
      <button class="tray-btn" onclick="toggleTrayDrawer()">
        <span>🍿 Lounge Tray</span>
        <span class="badge-count" id="trayCount">2</span>
      </button>
    </div>
  </nav>

  <!-- =========================================================================
       PAGE 1: CINEMA DETAILS (9-Section Architectural Tour)
       ========================================================================= -->
  <main class="page-view active" id="page-cinema">
