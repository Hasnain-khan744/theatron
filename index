        joke: "I asked Doctor Strange how many futures he saw where I don't finish my Truffle Popcorn before the trailers end. He held up one finger... and even in that one I ate my friend's nachos.",
        votes: 42,
        voted: false
      },
      {
        id: 2,
        author: "Ayesha Malik",
        movie: "Midnight Whispers",
        joke: "Why don't ghosts ever buy tickets for THEATRON's Horror Night? Because they can already see right through the plot—and they can't hold the popcorn bucket!",
        votes: 31,
        voted: false
      },
      {
        id: 3,
        author: "Tariq Mehmood",
        movie: "Dune: Messiah",
        joke: "My recliner in Hall 01 was so comfortable during Dune that I didn't walk without rhythm—I slept with full surround sound.",
        votes: 24,
        voted: false
      }
    ];

    function renderDailyJokes() {
      const grid = document.getElementById("dailyJokesGrid");
      if (!grid) return;

      const sorted = [...dailyJokesData].sort((a, b) => b.votes - a.votes);
      grid.innerHTML = sorted.map((entry, idx) => {
        const isLeader = idx === 0;
        return `
          <div class="rounded-2xl p-5 flex flex-col justify-between group-card" style="background: ${isLeader ? 'linear-gradient(160deg, rgba(212,175,55,0.14), #130407)' : '#130407'}; border: 1px solid ${isLeader ? 'var(--gold-primary)' : 'var(--border-burgundy)'};">
            <div>
              <div class="flex justify-between items-center gap-2 mb-3">
                <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full" style="background: ${isLeader ? 'var(--gold-primary)' : 'rgba(158,27,50,0.35)'}; color: ${isLeader ? '#120406' : 'var(--gold-light)'};">
                  ${isLeader ? '👑 #1 DAILY LEADER (FREE TICKET + FOOD)' : `#${idx + 1} CONTENDER`}
                </span>
                <span class="text-[11px]" style="color: var(--text-muted);">🎬 ${entry.movie}</span>
              </div>
              <p class="text-xs md:text-sm leading-relaxed italic mb-4" style="color: #f4eae8;">
                "${entry.joke}"
              </p>
            </div>
            <div class="flex justify-between items-center pt-3" style="border-top: 1px solid rgba(255,255,255,0.07);">
              <strong class="text-xs" style="color: var(--gold-light);">— ${entry.author}</strong>
              <button onclick="voteForJoke(${entry.id})" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-transform hover:scale-105" style="background: ${entry.voted ? 'var(--gold-primary)' : 'rgba(158,27,50,0.35)'}; color: ${entry.voted ? '#120406' : '#fff'}; border: 1px solid var(--border-gold); cursor: pointer;">
                😂 ${entry.voted ? 'Voted' : 'Laugh'} (${entry.votes})
              </button>
            </div>
          </div>
        `;
      }).join("");
    }

    window.submitDailyJoke = function(e) {
      e.preventDefault();
      const author = document.getElementById("jokeAuthorInput").value.trim();
      const movie = document.getElementById("jokeMovieInput").value.trim();
      const joke = document.getElementById("jokeTextInput").value.trim();

      if (!author || !movie || joke.length < 8) {
        showToast("Please enter your name, the movie you watched, and your joke!");
        return;
      }

      dailyJokesData.unshift({
        id: Date.now(),
        author,
        movie,
        joke,
        votes: 1,
        voted: true
      });

      e.target.reset();
      renderDailyJokes();
      showToast("Your joke is live in the Post-Credits Laugh Off!");
    };

    window.voteForJoke = function(id) {
      const entry = dailyJokesData.find(j => j.id === id);
      if (!entry) return;
      entry.voted = !entry.voted;
      entry.votes += entry.voted ? 1 : -1;
      renderDailyJokes();
      if (entry.voted) showToast(`Voted for ${entry.author}'s joke!`);
    };

    // Initialize everything cleanly on load
    renderCinemaGallery();
    renderCinemaFaqs();
    renderCulturalHeritageCuisine();
    selectAuditorium(0);
    renderCombos();
    renderMovieGenreCuration();
    renderFoodBattle();
    renderCustomerFavourites();
    renderCategoryTabs();
    renderMenu();
    updateTrayUI();
    renderReviewAnalytics();
    renderReviewOfTheWeek();
    renderDailyJokes();
    renderReviews();
    initScrollReveals(document.getElementById("page-cinema"));
  </script>
</body>
</html>
